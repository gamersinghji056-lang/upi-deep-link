# Runtime environment (set through Railway or your shell; .env is not auto-loaded).
DATABASE_URL=
NODE_ENV=production
PUBLIC_BASE_URL=https://pay.wtron.org
PORT=3000

# Diagnostics require NODE_ENV=development AND this flag, and loopback access.
UPI_DIAGNOSTICS=0

# Reserved server-side configuration for the disabled Paytm adapter.
# Credentials alone do NOT enable it: a reviewed gateway/status client is required.
PAYTM_ENVIRONMENT=
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE_NAME=
PAYTM_CALLBACK_URL=
