# Runtime environment (set through Railway or your shell; .env is not auto-loaded).
DATABASE_URL=
NODE_ENV=production
PUBLIC_BASE_URL=https://pay.wtron.org
PORT=3000

# Diagnostics require NODE_ENV=development AND this flag, and loopback access.
UPI_DIAGNOSTICS=0

# PhonePe Payment Gateway Custom Checkout (UPI Intent v2)
# These are issued in PhonePe Business > Developer Settings.
PHONEPE_ENVIRONMENT=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
# Required only for partner integrations where PhonePe has enabled end-merchant routing.
PHONEPE_MERCHANT_ID=

# Legacy disabled Paytm adapter scaffold.
PAYTM_ENVIRONMENT=
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE_NAME=
PAYTM_CALLBACK_URL=
