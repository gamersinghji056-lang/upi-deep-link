<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="WPAY Agent"
                android:src="@drawable/ic_wpay_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WPAY Agent"
                    android:textColor="@color/wpay_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Secure device onboarding"
                    android:textColor="@color/wpay_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Connect this payment device"
            android:textColor="@color/wpay_text"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Enter the one-time code from your WPAY dashboard. Permissions are requested only after the code is accepted."
            android:textColor="@color/wpay_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:id="@+id/pairStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_tile"
                    android:contentDescription="Pairing"
                    android:padding="9dp"
                    android:src="@drawable/ic_shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter Pairing Code"
                        android:textColor="@color/wpay_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="8-character code · valid for 10 minutes"
                        android:textColor="@color/wpay_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/pairingCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:autofillHints=""
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:hint="Enter 8-character pairing code"
                android:inputType="textCapCharacters"
                android:letterSpacing="0.12"
                android:maxLength="8"
                android:singleLine="true"
                android:textColor="@color/wpay_text"
                android:textColorHint="#71668A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/pairContinue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_primary"
                android:enabled="false"
                android:stateListAnimator="@null"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@color/wpay_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pairingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Enter the dashboard pairing code to continue"
                android:textColor="@color/wpay_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_tile"
                    android:contentDescription="Permissions"
                    android:padding="9dp"
                    android:src="@drawable/ic_shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grant Permissions"
                        android:textColor="@color/wpay_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Required for automatic monitoring"
                        android:textColor="@color/wpay_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_sms" android:contentDescription="SMS" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SMS access" android:textColor="@color/wpay_text" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Receive and reconcile payment SMS" android:textColor="@color/wpay_muted" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:id="@+id/smsPermissionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Required" android:textColor="@color/wpay_amber" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_phone" android:contentDescription="SIM" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SIM / phone state" android:textColor="@color/wpay_text" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Read SIM, number and network details" android:textColor="@color/wpay_muted" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:id="@+id/phonePermissionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Required" android:textColor="@color/wpay_amber" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_location" android:contentDescription="Location" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Location" android:textColor="@color/wpay_text" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current device diagnostics location" android:textColor="@color/wpay_muted" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:id="@+id/locationPermissionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Required" android:textColor="@color/wpay_amber" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_bell" android:contentDescription="Notifications" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notifications" android:textColor="@color/wpay_text" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monitoring and sync status alerts" android:textColor="@color/wpay_muted" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:id="@+id/notificationPermissionStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Required" android:textColor="@color/wpay_amber" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/grantPermissions"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_secondary"
                android:stateListAnimator="@null"
                android:text="Grant Required Permissions"
                android:textAllCaps="false"
                android:textColor="@color/wpay_text"
                android:textStyle="bold" />

            <Button
                android:id="@+id/completeSetup"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_primary"
                android:enabled="false"
                android:stateListAnimator="@null"
                android:text="Complete Setup"
                android:textAllCaps="false"
                android:textColor="@color/wpay_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/changeCode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:text="Use a different pairing code"
                android:textAllCaps="false"
                android:textColor="@color/wpay_muted" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
