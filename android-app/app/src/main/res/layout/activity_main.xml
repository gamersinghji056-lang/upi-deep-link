<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WPAY Agent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="This device confirms incoming bank credit alerts for your own payment account. Before pairing, the app asks for SMS receive, SIM/phone-state and location permissions. It does not upload your SMS inbox or full SMS text."
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Permissions"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/smsPermissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="SMS receive: checking..." />

        <TextView
            android:id="@+id/phonePermissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIM / phone state: checking..." />

        <TextView
            android:id="@+id/locationPermissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location: checking..." />

        <Button
            android:id="@+id/grantPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Review &amp; Grant Permissions" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Pair device"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pairingCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:hint="8-character pairing code"
            android:inputType="textCapCharacters"
            android:maxLength="8"
            android:singleLine="true" />

        <Button
            android:id="@+id/pairDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Connect This Device" />

        <TextView
            android:id="@+id/pairingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Not paired" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Device diagnostics"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Device status unavailable" />

        <Button
            android:id="@+id/sendDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Send Diagnostics Now" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Last credit event"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lastEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No credit SMS processed yet." />

        <Button
            android:id="@+id/resetPairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:text="Reset Local Pairing" />

    </LinearLayout>
</ScrollView>
